# Running the agent outside Docker (`uv run poe dev`): copy to apps/agent-service/.env (git-ignored). The Docker
# stack is configured in infra/.env instead. Secrets never go in this template.

# --- Runtime ---
APP_ENV=dev                              # dev | test | production (production refuses placeholder secrets)
AGENT_LANGUAGE=vi                        # text written for people

# --- Models (config/llm/<profile>.yaml; docs/LOCAL_LLM.md) ---
LLM_PROFILE=local                        # local | local-small | local-large | google (production) | anthropic | openai | openrouter-fast | scripted
# Per-role override, provider:model. Roles: SHOPPER (customer assistant), PLANNER, WRITER, JUDGE, WORKER.
# LLM_MODEL_SHOPPER=google_genai:gemini-3.5-flash-lite
OLLAMA_BASE_URL=http://localhost:11434
LLM_DAILY_BUDGET_USD=2                   # the merchant agents stop for the day at this spend
# LLM_EMBEDDING_PROFILE=local             # embed with another profile's model (keeps an existing knowledge index)
# Provider key of the chosen profile:
# GOOGLE_API_KEY=                         # chat models, embeddings and the decision model of the google profile
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=                         # also the OpenRouter key for openrouter-fast
# Decision model that routes customer turns before the planner (shop_agent.decision); no key = routing off.
# Unset: Gemini Decision with a google profile (GOOGLE_API_KEY), otherwise TypeSafe Jev through OpenRouter.
# DECISION_PROVIDER=                      # google | openrouter | typesafe
# OPENROUTER_API_KEY=                     # optional: openrouter profiles reuse OPENAI_API_KEY (the OpenRouter key)
# TYPESAFE_API_KEY=                       # only with DECISION_PROVIDER=typesafe
# DECISION_MODEL=                         # default: gemini-decision-1 | ~typesafe/jev-latest | jev-latest

# --- Databases ---
# The agent's own database (pgvector knowledge base): infra/sql/shop_agent.sql
DATABASE_URL=postgresql://shop_agent:<shop_agent password>@localhost:5432/shop_agent
# Read-only analytics views of the web shop: infra/sql/ci_reader.sql
SHOP_READ_DSN=postgresql://ci_reader:<ci_reader password>@localhost:5432/web_ecommerce

# --- Shop access ---
SHOP_ADAPTER=sql                         # sql | fake (development) | http (server tests)
SHOP_API_BASE_URL=http://localhost:6050/api/agent/v1
SHOP_API_TOKEN=change-me                 # the web's AGENT_API_TOKEN

# --- Auth: actor tokens minted by the web gateway (same value as the web's AGENT_ACTOR_SECRET) ---
AGENT_ACTOR_SECRET=change-me
# The Agent Server's own URL, for runtimes without an in-process loopback (Aegra) and for `shop-agent sync-crons`.
# AGENT_SERVER_URL=http://localhost:2024

# --- Loop timing ---
APPROVAL_TTL_HOURS=48
SIGNAL_COOLDOWN_HOURS=72
# DEMO_MEASURE_AFTER_MINUTES=2           # demo only, refused with APP_ENV=production

# --- Feature flags ---
# FF_MARKET_TRENDS=true
# FF_MARKET_SCRAPING=true                # competitors' own sites only; marketplaces are always denylisted

# --- Market data (the `collect` graph, docs/GROWTH_AGENT.md section 2) ---
# MARKET_CHROMIUM_PATH=                   # a local Chromium for competitor_sites (default: `playwright install chromium`)

# --- Tracing (Langfuse; unset = off). Dev-only optional: LANGSMITH_TRACING, LANGSMITH_API_KEY ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Tests ---
# AGENT_TEST_DATABASE_URL=postgresql://shop_agent_test:<password>@localhost:5432/shop_agent_test
# A superuser connection: the -m db tests create a scratch shop database and the ci_reader role with it.
# PG_SUPERUSER_URL=postgresql://postgres:<password>@localhost:5432/postgres
# AGENT_APPROVAL_SECRET_TEST=
